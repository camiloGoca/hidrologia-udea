# Frontend
VITE_API_BASE_URL=/api/v1

# Local PostgreSQL container.
# Copy this file to .env for local development and replace the password.
# Do not commit real secrets.
POSTGRES_DB=hidrologia_udea
POSTGRES_USER=hidrologia_app
POSTGRES_PASSWORD=replace-me-local-only
POSTGRES_HOST_PORT=5432

# Backend database connection for the Spring local profile.
DB_URL=jdbc:postgresql://127.0.0.1:5432/hidrologia_udea
DB_USERNAME=hidrologia_app
DB_PASSWORD=replace-me-local-only

CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
QUESTION_IMAGE_MAX_BYTES=5242880
QUESTION_IMAGE_MAX_FILE_SIZE=5MB
QUESTION_IMAGE_MAX_REQUEST_SIZE=6MB
QUESTION_IMAGE_MAX_WIDTH=12000
QUESTION_IMAGE_MAX_HEIGHT=12000
QUESTION_IMAGE_MAX_PIXELS=60000000
