# Normalize text files to LF in the repository.
* text=auto eol=lf

# Keep Windows command scripts with CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files should not be normalized or diffed as text.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.jar binary
*.war binary
*.gz binary
